@namespace Ebay.Blazor.Components

@inject EbayProductState ebayProdService
<div class="container">
    <div class="search-container">

        <select @bind="@ebayProdService.RequestModel.CategoryId" class="category-select">

            @foreach (var o in ebayProdService.GetCategory())
            {
                <option value="@o.Value">@o.Label</option>
            }
        </select>

        <input type="text" @bind="@ebayProdService.RequestModel.Keyword" class="search-input"
               placeholder="Search for anything">

        <button @onclick="@Search" class="search-button">Search</button>
    </div>
</div>


@code {

    protected override async Task OnInitializedAsync()
    {
        await ebayProdService.LoadDataModel();
        await ebayProdService.GetData();
    }

    public async Task SelectCategory(int? category)
    {
        ebayProdService.RequestModel.CategoryId = category;
        @* await InvokeAsync(() => StateHasChanged()); *@
        await ebayProdService.GetData();
    }


    public void Dispose()
    {
        ebayProdService.OnChange -= StateHasChanged;
    }

    public void Search()
    {
        ebayProdService.GetData();
    }



}

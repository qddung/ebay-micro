@namespace Ebay.Blazor.Components

@inject EbayProductState ebayProdService
<div class="container">
    <div class="search-container">
        <Select @bind-SelectedValue="@ebayProdService.RequestModel.CategoryId" TValue="int?" Class="category-select">
            @foreach (var o in ebayProdService.GetCategory())
            {
                <SelectItem Value=@o.Value>@o.Label</SelectItem>
            }
        </Select>

        <input type="text" @bind="@ebayProdService.RequestModel.Keyword" class="search-input"
            placeholder="Search for anything">

        <button class="search-button">Search</button>
    </div>
</div>


@code {
    public async Task SelectCategory(int? category)
    {
        ebayProdService.RequestModel.CategoryId = category;
        @* await InvokeAsync(() => StateHasChanged()); *@
        await ebayProdService.GetData();
    }



}
